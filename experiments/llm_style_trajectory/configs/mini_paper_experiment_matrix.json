      "id": "D",
      "name": "motion_continuity_and_retiming",
      "baseline": "raw robot_target_poses.csv",
      "ours": "robot_target_poses_smoothed.csv",
      "metrics": [
        "dt_nonpositive_count",
        "max_speed_m_s",
        "max_accel_m_s2",
        "max_jerk_m_s3",
        "recommended_for_coppeliasim_playback",
        "recommended_for_ik_dry_run"
